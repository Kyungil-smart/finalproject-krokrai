  stringId: STR_CAP_001014
  KR: "\uACE0\uC591\uC774\uB294 \uB2E8\uB9DB\uC744 \uC804\uD600 \uBAA8\uB985\uB2C8\uB2E4.
    \uD558\uC9C0\uB9CC \uC544\uC774\uC2A4\uD06C\uB9BC\uC774\uB098 \uC124\uD0D5\uC744
    \uC785\uD78C \uB3C4\uB11B\uC744 \uBA39\uC744 \uB54C \uAD00\uC2EC\uC744 \uBCF4\uC774\uB294
    \uACBD\uC6B0\uB294 \uC9C0\uBC29\uC758 \uACE0\uC18C\uD55C \uB0C4\uC0C8\uC5D0 \uC774\uB04C\uB838\uC744
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C\uC774 \uBA39\uB294 \uB514\uC800\uD2B8\uB294
    \uACE0\uC591\uC774\uC5D0\uAC8C \uBE44\uB9CC\uC774\uB098 \uCDCC\uC7A5\uC5FC\uC758
    \uC6D0\uC778\uC774 \uB420 \uC218 \uC788\uC73C\uB2C8\uAE4C, \uC544\uBB34\uB9AC
    \uCCD0\uB2E4\uBD10\uB3C4 \uC8FC\uBA74 \uC548\uB429\uB2C8\uB2E4!"
  EN: "\r"
