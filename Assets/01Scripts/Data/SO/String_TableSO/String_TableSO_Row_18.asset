  stringId: STR_CAP_001011
  KR: "\uC218\uC5FC\uD53C\uB85C\uC99D\uD6C4\uAD70\uC774\uB77C\uACE0 \uB4E4\uC5B4\uBCF4\uC168\uB098\uC694?
    \uACE0\uC591\uC774\uC758 \uC218\uC5FC\uC740 \uC544\uC8FC \uC608\uBBFC\uD55C \uAC10\uAC01
    \uAE30\uAD00\uC774\uC5D0\uC694. \uADF8\uB798\uC11C \uAE4A\uACE0 \uC881\uC740
    \uADF8\uB987\uC744 \uC4F0\uBA74, \uBC25\uC744 \uBA39\uC744 \uB54C \uC218\uC5FC\uC774
    \uADF8\uB987 \uBCBD\uC5D0 \uB2FF\uC544\uC11C \uC2A4\uD2B8\uB808\uC2A4\uB97C \uBC1B\uC544\uC694!
    \uC774\uB7F0 \uC99D\uC0C1\uC774 \uC2EC\uD574\uC9C0\uBA74 \uBC25\uC744 \uBA39\uB294
    \uAC83\uC744 \uAE30\uD53C\uD558\uAC8C \uB418\uC11C \uC601\uD5A5 \uBD88\uADE0\uD615\uC744
    \uCD08\uB798\uD560 \uC218 \uC788\uB290\uB2C8 \uC870\uC2EC\uD574\uC57C \uD574\uC694!"
  EN: "\r"
