  stringId: STR_DIA_000048
  KR: "\"\uADF8\uB9AC\uACE0 \uD658\uBB18\uBCF5\uC774 \uB108\uBB34 \uD5D0\uB801\uD558\uBA74
    \uD2C8\uC73C\uB85C \uADF8\uB8E8\uBC0D\uD574\uC11C \uC0C1\uCC98\uAC00 \uB367\uB098\uAC70\uB098,
