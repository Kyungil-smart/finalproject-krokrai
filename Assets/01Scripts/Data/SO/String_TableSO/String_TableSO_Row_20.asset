  m_Name: String_TableSO_Row_20
  m_EditorClassIdentifier: 
  stringId: STR_CAP_001013
  KR: "\uC6B0\uB9AC \uACE0\uC591\uC774 \uBC30\uAC00 \uB298\uC5B4\uC838 \uBC14\uB2E5\uC5D0
    \uB2FF\uC744 \uB4EF \uCD9C\uB801\uAC70\uB824 \uACE0\uBBFC\uC774\uC2E0\uAC00\uC694?
    \uC0AC\uC2E4 \uADF8 \uBC43\uC0B4, \uB2E8\uC21C\uD788 \uC0B4\uCC10 \uAC8C \uC544\uB2D0
    \uC218 \uC788\uC5B4\uC694! \uC774 \uBD80\uC704\uC758 \uC9C4\uC9DC \uC774\uB984\uC740
    \uC6D0\uC2DC \uC8FC\uBA38\uB2C8\uC785\uB2C8\uB2E4. \uACF5\uACA9\uC744 \uBC1B\uC558\uC744
    \uB54C \uC7A5\uAE30\uB97C \uBCF4\uD638\uD558\uACE0, \uC804\uC18D\uB825\uC73C\uB85C
    \uB2EC\uB9B4 \uB54C \uB4B7\uB2E4\uB9AC\uB97C \uAD00\uC808 \uB05D\uAE4C\uC9C0
    \uCB49 \uBED7\uC744 \uC218 \uC788\uAC8C \uD574\uC8FC\uB294 \uC544\uC8FC \uC911\uC694\uD55C
    \uD53C\uBD80 \uC5EC\uC720\uBD84\uC774\uC5D0\uC694. \uBB3C\uB860 \uC9C4\uC9DC
    \uBE44\uB9CC\uC77C \uC218\uB3C4 \uC788\uC73C\uB2C8 \uD5F7\uAC08\uB9B0\uB2E4\uBA74
    \uAC08\uBE44\uBF08\uB97C \uB9CC\uC838\uBCF4\uC138\uC694! \uB450\uAEBC\uC6B4 \uC9C0\uBC29\uC5D0
    \uB36E\uC5EC \uBF08\uAC00 \uC798 \uC548 \uB9CC\uC838\uC9C4\uB2E4\uBA74... \uADF8\uAC74
    \uC9C4\uC9DC \uBC43\uC0B4\uC785\uB2C8\uB2E4."
  EN: "\r"
