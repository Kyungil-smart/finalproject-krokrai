  stringId: STR_CAP_001009
  KR: "\uACE0\uC591\uC774 \uACE8\uACE8 \uC18C\uB9AC\uB97C \uB0B4\uBA74 \uBCF4\uD1B5
    \uAE30\uBD84 \uC88B\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC2DC\uC8E0? \uBB3C\uB860
    \uD589\uBCF5\uD560 \uB54C\uB3C4 \uB0B4\uC9C0\uB9CC, \uC0AC\uC2E4 \uBAB8\uC774
    \uC5B4\uD504\uAC70\uB098 \uC2A4\uD2B8\uB808\uC2A4\uB97C \uBC1B\uC744 \uB54C\uB3C4
    \uC2A4\uC2A4\uB85C\uB97C \uC548\uC2EC\uC2DC\uD0A4\uB824\uACE0 \uACE8\uACE8\uC1A1\uC744
    \uBD80\uB985\uB2C8\uB2E4. \uD3C9\uC18C\uC640 \uB2E4\uB974\uAC8C \uD798 \uC5C6\uC774
    \uACE8\uACE8\uAC70\uB9AC\uBA74 \uC5B4\uB514\uAC00 \uBD88\uD3B8\uD55C \uAC83\uC740
    \uC544\uB2CC \uC9C0 \uC138\uC2EC\uD558\uAC8C \uC0B4\uD3B4\uC8FC\uC138\uC694."
  EN: "\r"
